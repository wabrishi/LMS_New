{
  "name": "onlineclass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:dev:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:dev:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:dev:setup": "prisma db push --schema=prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "db:prod:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:prod:push": "prisma db push --schema=prisma/schema.prisma",
    "db:prod:seed": "tsx prisma/seed.prod.ts",
    "db:studio": "prisma studio --schema=prisma/schema.sqlite.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.28.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
